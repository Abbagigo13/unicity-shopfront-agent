# testnet | testnet2 | mainnet | dev
UNICITY_NETWORK=testnet2

# testnet2 gateway key — not a secret, published in sphere-sdk's own
# .env.example. A mainnet key IS a secret — never commit that one.
UNICITY_API_KEY=sk_ddc3cfcc001e4a28ac3fad7407f99590

# This shop's @handle
SHOP_NAMETAG=abbagigoo_shop

# Leave blank on first run — the agent prints a generated mnemonic,
# copy it back here so the shop keeps its identity (and stock) across restarts.
WALLET_MNEMONIC=your_test_wallet_mnemonic_here

# Path to the catalog file
CATALOG_PATH=./catalog.json

# Show a USD estimate alongside quotes (CoinGecko free tier, no key needed)
ENABLE_FIAT_PRICE=true

# Re-post catalog listings to the Market every N hours (intents expire)
REPOST_INTERVAL_HOURS=24

# --- GenLayer (Smart Price Check appraisal) ---

# localnet | studionet | testnetAsimov
GENLAYER_CHAIN=studionet

# Your deployed Smart Price Check contract
GENLAYER_CONTRACT_ADDRESS=0x87eE19C1D3a0B148E4D197Ed5a3B01163ff96609

# Private key for the account that submits appraisal write-transactions.
# Generate one with: node -e "console.log(require('genlayer-js').generatePrivateKey())"
GENLAYER_PRIVATE_KEY=your_test_private_key_here

# Run `npm run inspect-contract` first and fill these in with the REAL
# method names from your contract's schema — these are placeholders.
GENLAYER_SUBMIT_METHOD=check_price
GENLAYER_RESULT_METHOD=get_result

GENLAYER_POLL_INTERVAL_MS=3000
GENLAYER_POLL_TIMEOUT_MS=60000